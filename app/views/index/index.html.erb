<% content_for :title, "Zignal - Effortless AI tracking of all your investments" %>
<% content_for :head do %>
    <style>
        .glass-card {
            background-color: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }

        .hover-scale {
            transition: transform 0.3s ease;
        }

        .hover-scale:hover {
            transform: scale(1.03);
        }

        .animate-fade-in {
            animation: fadeIn 0.4s ease-out forwards;
        }

        .animate-float {
            animation: float 6s ease-in-out infinite;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes float {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }
    </style>
<% end %>
    <!-- Hero Section -->
    <section class="relative min-h-screen pt-24 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-b from-purple-50/20 to-white/0 -z-10"></div>

        <!-- Decorative Elements -->
        <div class="absolute top-1/4 -left-64 w-96 h-96 bg-purple-100/30 rounded-full blur-3xl"></div>
        <div class="absolute bottom-1/3 -right-64 w-96 h-96 bg-pink-100/30 rounded-full blur-3xl"></div>

        <div class="max-w-7xl mx-auto px-6 md:px-12 pt-20 md:pt-32">
            <div class="flex flex-col items-center text-center">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-100/50 text-purple-500 text-sm font-medium mb-8 animate-fade-in">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-400"></span>
                    </span>
                    Introducing Zignal AI
                </div>

                <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight text-gray-800 mb-6 leading-tight">
                    Effortless AI tracking of all your investments
                </h1>

                <p class="text-xl text-gray-600 max-w-3xl mb-10">
                    Boost investment handling by 50%, slash meetings by half <br />and track strategic metrics 24/7
                </p>

                <div class="flex flex-col sm:flex-row gap-5">
                    <button class="px-8 py-4 text-lg bg-purple-400 text-white hover:shadow-lg hover:shadow-purple-200/30 rounded-xl font-medium transition-all duration-300 group">
                        Start for free
                        <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-5 w-5 inline transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </button>
                    <button class="px-8 py-4 text-lg border-2 border-purple-300 text-purple-500 bg-transparent hover:bg-purple-50 rounded-xl font-medium transition-all duration-300">
                        How it works
                    </button>
                </div>

                <div class="mt-20 relative w-full max-w-5xl mx-auto animate-float">
                    <div class="">
                        <div class="w-full bg-gradient-to-br from-blue-100 to-blue-100 opacity-30"></div>
                        <div class="inset-0 flex items-center justify-center">
                            <div class="relative">
                                <%= image_tag "circlerefined.gif", class: "w-full object-cover" %>
                                <div class="inset-0 flex items-center justify-center text-white font-bold">
                                    Your Text Here
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-24 relative">
        <div class="max-w-7xl mx-auto px-6 md:px-12">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-bold mb-4">
                    Supercharge Your Productivity
                </h2>
                <p class="text-gray-600 max-w-2xl mx-auto">
                    Zignal combines cutting-edge AI with intuitive design to help you focus on what matters most.
                </p>
            </div>

            <div class="grid grid-cols-1 gap-8">
                <!-- Feature 1 -->
                <div class="glass-card p-8 rounded-2xl hover-scale">
                    <div class="flex flex-col gap-4">
                        <div class="h-14 w-14 rounded-xl bg-purple-100 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="20" x2="18" y2="10"></line>
                                <line x1="12" y1="20" x2="12" y2="4"></line>
                                <line x1="6" y1="20" x2="6" y2="14"></line>
                            </svg>
                        </div>

                        <h3 class="text-xl font-semibold mt-2">Track Your Progress</h3>

                        <p class="text-gray-600 leading-relaxed">
                            Automatically track and visualize your progress with advanced AI analytics that identifies patterns and suggests optimizations.
                        </p>
                    </div>
                </div>

                <!-- Feature 2 -->
                <div class="glass-card p-8 rounded-2xl hover-scale">
                    <div class="flex flex-col gap-4">
                        <div class="h-14 w-14 rounded-xl bg-pink-100 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-pink-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="18" cy="5" r="3"></circle>
                                <circle cx="6" cy="12" r="3"></circle>
                                <circle cx="18" cy="19" r="3"></circle>
                                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                            </svg>
                        </div>

                        <h3 class="text-xl font-semibold mt-2">Share with Stakeholders</h3>

                        <p class="text-gray-600 leading-relaxed">
                            Generate professional reports and updates for stakeholders with a single click. Share the right information with the right people.
                        </p>
                    </div>
                </div>

                <!-- Feature 3 -->
                <div class="glass-card p-8 rounded-2xl hover-scale">
                    <div class="flex flex-col gap-4">
                        <div class="h-14 w-14 rounded-xl bg-blue-100 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                                <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"></path>
                                <path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
                            </svg>
                        </div>

                        <h3 class="text-xl font-semibold mt-2">AI Meeting Assistant</h3>

                        <p class="text-gray-600 leading-relaxed">
                            Let Zignal join your meetings, take notes, and handle follow-ups. Your AI assistant can also receive and respond to emails on your behalf.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-24 relative">
        <div class="absolute inset-0 bg-gradient-to-b from-purple-50/20 to-white/0 -z-10"></div>

        <div class="max-w-5xl mx-auto px-6 md:px-12">
            <div class="glass-card rounded-3xl p-12 md:p-16 text-center">
                <h2 class="text-3xl md:text-4xl font-bold mb-6">
                    Ready to transform your workflow?
                </h2>
                <p class="text-gray-600 max-w-2xl mx-auto mb-10">
                    Join the thousands of professionals using Zignal to automate tasks, track progress, and collaborate more effectively.
                </p>

                <div class="flex flex-col sm:flex-row gap-5 justify-center">
                    <button class="px-8 py-4 text-lg bg-purple-400 text-white hover:shadow-lg hover:shadow-purple-200/30 rounded-xl font-medium transition-all duration-300 group">
                        Get started for free
                        <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-5 w-5 inline transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </button>
                    <button class="px-8 py-4 text-lg border-2 border-purple-300 text-purple-500 bg-transparent hover:bg-purple-50 rounded-xl font-medium transition-all duration-300">
                        Schedule a demo
                    </button>
                </div>

                <p class="text-sm text-gray-500 mt-6">
                    No credit card required. 14-day free trial.
                </p>
            </div>
        </div>
    </section>

    <!-- Footer removed; now rendered from layout -->
