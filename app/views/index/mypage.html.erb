<% content_for :title, "My Page - Zignal" %>

    <!-- Main Content -->
    <section class="pt-24 pb-12">
        <div class="max-w-4xl mx-auto px-6 md:px-12">
            <div class="bg-white rounded-2xl shadow-sm p-8">
                <h1 class="text-3xl font-bold text-gray-800 mb-6">Welcome to Your Dashboard</h1>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Stats Card -->
                    <div class="bg-purple-50 rounded-xl p-6">
                        <h3 class="text-lg font-semibold text-purple-700 mb-2">Your Progress</h3>
                        <p class="text-2xl font-bold text-purple-600">0</p>
                        <p class="text-sm text-purple-500">Investments tracked</p>
                    </div>

                    <!-- Quick Actions -->
                    <div class="bg-pink-50 rounded-xl p-6">
                        <h3 class="text-lg font-semibold text-pink-700 mb-2">Quick Actions</h3>
                        <button class="w-full bg-pink-200 hover:bg-pink-300 text-pink-700 py-2 px-4 rounded-lg transition-colors">
                            Add Investment
                        </button>
                    </div>

                    <!-- Recent Activity -->
                    <div class="bg-blue-50 rounded-xl p-6">
                        <h3 class="text-lg font-semibold text-blue-700 mb-2">Recent Activity</h3>
                        <p class="text-sm text-blue-600">No recent activity</p>
                    </div>
                </div>

                <div class="mt-8">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4">Getting Started</h2>
                    <div class="bg-gray-50 rounded-xl p-6">
                        <p class="text-gray-600">Welcome to Zignal! Start by adding your first investment to begin tracking your portfolio with AI-powered insights.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
